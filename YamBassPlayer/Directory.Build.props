<Project>
  <!-- Единственный источник версии релиза: её читают сборка, окно «О программе» и GitHub Release.
       Меняем здесь, коммитим в master — CD сам соберёт и опубликует v<Version>. -->
  <PropertyGroup>
    <Version>0.0.1</Version>
    <Product>YamBassPlayer</Product>
    <Company>Blesya</Company>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'YamBassPlayer.Api' and '$(MSBuildProjectName)' != 'YamBassPlayer.Api.Client'">
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
</Project>
